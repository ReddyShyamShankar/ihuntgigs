[Unit]
Description=Hunt server robot: applies to approved jobs on the company's own form (route 1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hunt
Group=hunt
WorkingDirectory=/opt/hunt
EnvironmentFile=/opt/hunt/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/opt/hunt/data/robot-home
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/hunt/browsers
ExecStart=/opt/hunt/.venv/bin/python -u -m hunt robot
TimeoutStartSec=15min
# One hidden browser at a time, capped so the other apps on this server never feel it.
MemoryMax=1G
CPUQuota=60%
Nice=10
# Sandbox (Chromium needs JIT memory, so MemoryDenyWriteExecute/RestrictNamespaces stay off here).
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/hunt/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
