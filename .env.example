# Copy to .env and fill real values. Never commit .env.
# AI brain: "chatgpt" = your ChatGPT plan via Sign in with ChatGPT (run `python -m hunt login`, no key here)
#           "claude"  = Anthropic API key below
HUNT_AI=chatgpt
# Optional: pick a model from `python -m hunt models` (empty = first one your plan lists)
HUNT_CHATGPT_MODEL=
HUNT_CHATGPT_EFFORT=
# Only for HUNT_AI=claude. Create at platform.claude.com (no expiry).
ANTHROPIC_API_KEY=
# Telegram bot token from @BotFather — where lead cards arrive.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat id (Hunt finds it for you on first /start).
TELEGRAM_CHAT_ID=
# Optional tuning
HUNT_MIN_SCORE=60
HUNT_MAX_AI_PER_RUN=25
# Countries you can work from (comma-separated, as job boards write them). Jobs limited to other countries are skipped.
HUNT_COUNTRIES=
HUNT_MAX_AI_PER_DAY=60
# Part of the daily limit kept for bids you ask for on Telegram (the automatic queue can't use it)
HUNT_BID_RESERVE=40
# Claude model + effort (only for HUNT_AI=claude).
HUNT_MODEL=claude-opus-5-5
HUNT_EFFORT=medium

# LinkedIn job alerts via Gmail (optional). App password: myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# HUNT_GMAIL_LABEL=Hunt/LinkedIn Jobs

# Phase 1: finance YouTube channels. Free key from Google Cloud (APIs & Services → Credentials →
# API key, restricted to "YouTube Data API v3"). API keys do not expire.
YOUTUBE_API_KEY=

# B8 outreach email (Microsoft 365 via Microsoft Graph, decision #22). Sending stays OFF until the
# inbox is warmed up. Entra app registration → Graph application permissions Mail.Send + Mail.Read,
# limited to the outreach mailbox(es). Client secret: pick the longest expiry (24 months), set a reminder.
# HUNT_SEND=off
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# HUNT_INBOXES=you@example.com
# HUNT_INBOX_DAILY=20          # per-inbox daily limit (raise slowly during warm-up)
# HUNT_SEND_PER_RUN=10
# HUNT_POSTAL_ADDRESS=         # required in every cold email; nothing sends without it
# Also set `auto_send: on` under `youtube:` in data/sources.yaml, or approved pitches stay send-by-hand.
# B8b follow-ups (PRD §12) — off by default. Same approval cards; any reply stops them.
# HUNT_FOLLOWUPS=off
# HUNT_FOLLOWUP_DAYS=3,7       # silent days before follow-up 1, then follow-up 2
# HUNT_FOLLOWUP_LANES=         # e.g. writing,design — empty = all lanes

# --- B9 dashboard (python -m hunt dashboard; add people with: python -m hunt adduser NAME [--owner]) ---
# Listens on this address; keep 127.0.0.1 and put an HTTPS proxy (Caddy) in front on the server.
HUNT_DASH_HOST=127.0.0.1
HUNT_DASH_PORT=8090
# 1 once the dashboard is served over HTTPS (adds the Secure flag to the login cookie)
HUNT_DASH_HTTPS=0
# How long a login lasts, 5-24 hours
HUNT_SESSION_HOURS=24
# Time zone for dates shown on the dashboard
HUNT_TZ=UTC

# Automatic applying (apply: auto sources, decision #29)
HUNT_SAFETY_HOURS=2             # ✋ Stop window before a note is sent; 0 = fully automatic (mode B)
HUNT_APPLIER_PROFILE=           # server robot: /opt/hunt/data/private/profile.yaml (empty = robot off, Mac only)
HUNT_ROBOT_LIVE=                # 1 = really submit; empty = fill the form only (test mode)
HUNT_ROBOT_PER_RUN=3            # jobs per 10-minute robot run
