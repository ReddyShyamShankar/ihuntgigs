# Copy to .env and fill real values. Never commit .env.
# AI brain: "chatgpt" = your ChatGPT plan via Sign in with ChatGPT (run `python -m hunt login`, no key here)
#           "claude"  = Anthropic API key below
HUNT_AI=chatgpt
# Optional: pick a model from `python -m hunt models` (empty = first one your plan lists)
HUNT_CHATGPT_MODEL=
HUNT_CHATGPT_EFFORT=
# Only for HUNT_AI=claude. Create at platform.claude.com (no expiry).
ANTHROPIC_API_KEY=
# Telegram bot token from @BotFather — where lead cards arrive.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat id (Hunt finds it for you on first /start).
TELEGRAM_CHAT_ID=
# Optional tuning
HUNT_MIN_SCORE=60
HUNT_MAX_AI_PER_RUN=25
HUNT_MAX_AI_PER_DAY=60
# Part of the daily limit kept for bids you ask for on Telegram (the automatic queue can't use it)
HUNT_BID_RESERVE=40
# Claude model + effort (only for HUNT_AI=claude).
HUNT_MODEL=claude-opus-5-5
HUNT_EFFORT=medium

# LinkedIn job alerts via Gmail (optional). App password: myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# HUNT_GMAIL_LABEL=Hunt/LinkedIn Jobs
